<Window x:Class="SpeedoMeter.MeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse Meter"
    Width="250"
    Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
    Topmost="False"
        Background="{DynamicResource WidgetBg}"
        AllowsTransparency="False">
    <Border Background="{DynamicResource WidgetBg}"
            BorderBrush="{DynamicResource WidgetBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                <TextBlock Text="NetPulse"
                           Foreground="{DynamicResource WidgetTitle}"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right"
                           x:Name="SourceText"
                           Text="Total traffic"
                           Foreground="{DynamicResource WidgetSubtext}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DOWN"
                               Foreground="{DynamicResource WidgetSubtext}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock x:Name="DownloadSpeedText"
                               Text="0 B/s"
                               Foreground="{DynamicResource WidgetDownload}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="UP"
                               Foreground="{DynamicResource WidgetSubtext}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock x:Name="UploadSpeedText"
                               Text="0 B/s"
                               Foreground="{DynamicResource WidgetUpload}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>