<Window x:Class="SpeedoMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetPulse"
        Width="520" Height="560"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SpeedLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlDarkTextBrushKey}}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SpeedValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Live Speed Cards -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="↓ Download" Style="{StaticResource SpeedLabel}" />
                    <TextBlock x:Name="DownloadSpeedText" Text="0 B/s" Style="{StaticResource SpeedValue}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="↑ Upload" Style="{StaticResource SpeedLabel}" />
                    <TextBlock x:Name="UploadSpeedText" Text="0 B/s" Style="{StaticResource SpeedValue}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Today's Usage -->
        <TextBlock Grid.Row="1" Text="Today's Usage" Style="{StaticResource SectionHeader}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="↓ Downloaded" Style="{StaticResource SpeedLabel}" />
                    <TextBlock x:Name="TodayDownloadText" Text="0 B" Style="{StaticResource SpeedValue}" FontSize="20" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="↑ Uploaded" Style="{StaticResource SpeedLabel}" />
                    <TextBlock x:Name="TodayUploadText" Text="0 B" Style="{StaticResource SpeedValue}" FontSize="20" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Usage History -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Usage History (Last 30 Days)" Style="{StaticResource SectionHeader}" Margin="0,8,0,8" />

            <ListView x:Name="HistoryListView"
                      BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                      BorderThickness="1"
                      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date" Width="160"
                                        DisplayMemberBinding="{Binding Date}" />
                        <GridViewColumn Header="Downloaded" Width="140"
                                        DisplayMemberBinding="{Binding Downloaded}" />
                        <GridViewColumn Header="Uploaded" Width="140"
                                        DisplayMemberBinding="{Binding Uploaded}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</Window>
