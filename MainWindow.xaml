<Window x:Class="SpeedoMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse"
        Width="760"
        Height="640"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SpeedLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SpeedValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="NetPulse"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <TextBlock Text="Live total traffic, adapter breakdown, and widget controls in one lightweight dashboard."
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Overview">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="↓ Download" Style="{StaticResource SpeedLabel}" />
                                <TextBlock x:Name="DownloadSpeedText" Text="0 B/s" Style="{StaticResource SpeedValue}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="↑ Upload" Style="{StaticResource SpeedLabel}" />
                                <TextBlock x:Name="UploadSpeedText" Text="0 B/s" Style="{StaticResource SpeedValue}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="↓ Downloaded Today" Style="{StaticResource SpeedLabel}" />
                                <TextBlock x:Name="TodayDownloadText" Text="0 B" Style="{StaticResource SpeedValue}" FontSize="20" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="↑ Uploaded Today" Style="{StaticResource SpeedLabel}" />
                                <TextBlock x:Name="TodayUploadText" Text="0 B" Style="{StaticResource SpeedValue}" FontSize="20" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Usage History (Last 30 Days)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <ListView x:Name="HistoryListView"
                                  BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                  BorderThickness="1"
                                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="180" DisplayMemberBinding="{Binding Date}" />
                                    <GridViewColumn Header="Downloaded" Width="170" DisplayMemberBinding="{Binding Downloaded}" />
                                    <GridViewColumn Header="Uploaded" Width="170" DisplayMemberBinding="{Binding Uploaded}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Adapters">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Active and recently used connections" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="Live adapter rates update every second. Today's totals include the in-memory buffer and persisted usage." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </StackPanel>

                    <ListView x:Name="AdapterListView"
                              BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                              BorderThickness="1"
                              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Adapter" Width="220" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Live Down" Width="110" DisplayMemberBinding="{Binding LiveDownloaded}" />
                                <GridViewColumn Header="Live Up" Width="110" DisplayMemberBinding="{Binding LiveUploaded}" />
                                <GridViewColumn Header="Today Down" Width="120" DisplayMemberBinding="{Binding TodayDownloaded}" />
                                <GridViewColumn Header="Today Up" Width="120" DisplayMemberBinding="{Binding TodayUploaded}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Desktop Widget" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <TextBlock Text="Choose what the desktop widget shows. Changes are saved immediately and applied on the next telemetry tick." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" />

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Widget mode" Style="{StaticResource SpeedLabel}" />
                            <ComboBox x:Name="WidgetModeComboBox"
                                      Width="220"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="WidgetModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Total traffic" Tag="total" />
                                <ComboBoxItem Content="Top active adapter" Tag="top-adapter" />
                                <ComboBoxItem Content="Selected adapter" Tag="selected-adapter" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Selected adapter" Style="{StaticResource SpeedLabel}" />
                            <ComboBox x:Name="WidgetAdapterComboBox"
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id"
                                      SelectionChanged="WidgetAdapterComboBox_SelectionChanged" />
                            <TextBlock Text="Only used when the widget mode is set to Selected adapter."
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
