<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>SpeedoMeter</AssemblyName>
    <RootNamespace>SpeedoMeter</RootNamespace>
    <Product>NetPulse</Product>
    <Description>A lightweight, real-time network speed monitor for Windows 11</Description>
    <Authors>Hardik Kanajariya</Authors>
    <Company>hardikkanajariya.in</Company>
    <Copyright>Copyright © 2026 Hardik Kanajariya</Copyright>
    <RepositoryUrl>https://github.com/hardikkanajariya-in/NetPulse</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

</Project>
